
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

MONGODB_URI=mongodb://127.0.0.1:27017/shipnow

# Opcional: usar solamente si necesitás forzar un DNS alternativo.
# MONGODB_DNS_SERVER=8.8.8.8

# Orígenes CORS permitidos, separados por coma.
# En producción configurá los dominios reales de tu frontend.
# CORS_ORIGINS=https://tu-frontend.com
